{
  "name": "WA Inbound → CRM activity",
  "nodes": [
    {
      "parameters": {
        "path": "wa-inbound",
        "options": {}
      },
      "id": "1",
      "name": "Webhook (Meta WA)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const m = $json.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\nreturn [{ json: { from: m?.from, text: m?.text?.body, wa_id: m?.id, ts: m?.timestamp } }];"
      },
      "id": "2",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.INDUSTRIA_API_URL }}/api/v1/webhooks/whatsapp/inbound",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "jsonParameters": true,
        "options": {}
      },
      "id": "3",
      "name": "Forward to API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook (Meta WA)": { "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]] },
    "Normalize": { "main": [[{ "node": "Forward to API", "type": "main", "index": 0 }]] }
  }
}
