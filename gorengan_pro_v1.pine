//@version=5
indicator("GORANGEN PRO – 15M Momentum Scanner (simplified)", overlay=true, timeframe="15")
// simplified script - use screener for multi-symbol
volMultiplier = input.float(2.5, "Volume Multiplier (x MA20)")
lookbackHigh = input.int(3, "Break High Lookback")
bodyThreshold = input.float(0.60, "Body % Threshold")
rsiLimit = input.int(75, "RSI Max")

vol = volume
ma20 = ta.sma(volume, 20)
volBreak = vol > volMultiplier * ma20

priceBreak = close > ta.highest(high, lookbackHigh)
candleBody = math.abs(close - open)
candleRange = high - low
bodyOK = candleRange > 0 ? (candleBody / candleRange) > bodyThreshold : false
rsiVal = ta.rsi(close, 14)
rsiOK = rsiVal < rsiLimit

signal = volBreak and priceBreak and bodyOK and rsiOK

plotshape(signal, title="BUY", style=shape.labelup, color=color.green, text="BUY", size=size.small, location=location.belowbar)
barcolor(signal ? color.new(color.green, 0) : na)
alertcondition(signal, title="GORANG SIGNAL", message="GORANG: Momentum Breakout 15M detected!")
