# =====================  IndustriaCRM env  =====================
# Copy to project-root .env, edit values, then `docker compose up -d`.
#
# Going to production?
#  1. Set APP_ENV=prod  (refuses to boot with any default below)
#  2. Generate fresh secrets:   openssl rand -hex 48
#  3. Use a strong POSTGRES_PASSWORD (NOT "industria")
#  4. Tighten CORS_ORIGINS to your real domain

# --- Environment ---
# "dev" seeds demo users (director@demo.local / demo1234 etc) + demo customers.
# "prod" refuses default secrets at boot and skips/deactivates demo accounts.
APP_ENV=dev

# --- Postgres ---
POSTGRES_USER=industria
POSTGRES_PASSWORD=industria
POSTGRES_DB=industriacrm

DATABASE_URL=postgresql+asyncpg://industria:industria@db:5432/industriacrm
DATABASE_SYNC_URL=postgresql+psycopg2://industria:industria@db:5432/industriacrm

# --- Redis ---
REDIS_URL=redis://cache:6379/0

# --- Auth ---
JWT_SECRET=please-change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- CORS (comma-separated list of allowed origins in prod) ---
# In dev it defaults to http://localhost:5173,http://localhost:3000
# In prod set this to your actual frontend URL, e.g. https://app.yourco.com
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- AI / LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
AI_BUDGET_IDR_MONTH=5000000

# --- WhatsApp Cloud API ---
WA_PROVIDER=meta_cloud
WA_TOKEN=
WA_PHONE_ID=

# --- Webhook secret (n8n <-> API) ---
N8N_WEBHOOK_SECRET=replace-me

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
S3_BUCKET=
S3_REGION=

# --- Locale ---
DEFAULT_CURRENCY=IDR
TIMEZONE=Asia/Jakarta

# --- Discount thresholds ---
DISCOUNT_AUTO_MAX=5
DISCOUNT_MANAGER_MAX=15

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
